<?xml version="1.0" encoding="utf-8"?>
<!-- Kinetic Design System - Settings Activity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/kinetic_surface">

    <!-- TopAppBar - Kinetic Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/kinetic_toolbar_height"
        android:background="@color/kinetic_surface"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:theme="@style/KineticToolbarStyle"
            app:title="@string/action_settings" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Settings Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_setting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kinetic_surface" />
</LinearLayout>