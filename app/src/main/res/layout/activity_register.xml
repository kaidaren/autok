<?xml version="1.0" encoding="utf-8"?>
<!-- Kinetic Design System - Register Activity -->
<!-- The Kinetic Architect: Technical precision meets organic motion -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:background="@color/kinetic_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TopAppBar - Kinetic Header -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kinetic_toolbar_height"
            android:background="@color/kinetic_surface"
            android:elevation="0dp"
            android:theme="@style/AppTheme.AppBarOverlay">

            <com.stardust.theme.widget.ThemeColorToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:theme="@style/KineticToolbarStyle"
                android:title="@string/text_register"
                app:layout_scrollFlags="scroll|enterAlways"
                app:popupTheme="@style/AppTheme.PopupOverlay"/>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Main Content - Scrollable -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/kinetic_spacing_md"
                android:paddingEnd="@dimen/kinetic_spacing_md"
                android:paddingTop="@dimen/kinetic_spacing_xl"
                android:paddingBottom="@dimen/kinetic_spacing_xl">

                <!-- Email Input Field (Kinetic Style) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/kinetic_spacing_lg"
                    android:hint="@string/text_email"
                    style="@style/KineticTextInputLayout">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kinetic_input_height"
                        android:textColor="@color/kinetic_on_surface"
                        android:textSize="@dimen/kinetic_text_body_md"
                        android:inputType="textEmailAddress"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Username Input Field (Kinetic Style) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/kinetic_spacing_lg"
                    android:hint="@string/text_username"
                    style="@style/KineticTextInputLayout">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kinetic_input_height"
                        android:textColor="@color/kinetic_on_surface"
                        android:textSize="@dimen/kinetic_text_body_md"
                        android:inputType="text"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Input Field (Kinetic Style) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/kinetic_spacing_xl"
                    android:hint="@string/text_password"
                    style="@style/KineticTextInputLayout"
                    app:passwordToggleEnabled="true">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kinetic_input_height"
                        android:textColor="@color/kinetic_on_surface"
                        android:textSize="@dimen/kinetic_text_body_md"
                        android:inputType="textPassword"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Register Button (Bottom CTA) - Gradient Primary -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/register"
        android:layout_width="match_parent"
        android:layout_height="@dimen/kinetic_button_height"
        android:layout_gravity="bottom"
        android:background="@color/kinetic_primary"
        android:foreground="?selectableItemBackground"
        android:text="@string/text_register"
        android:textColor="@color/kinetic_on_primary"
        android:textSize="@dimen/kinetic_text_title_md"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:elevation="0dp"/>

</FrameLayout>