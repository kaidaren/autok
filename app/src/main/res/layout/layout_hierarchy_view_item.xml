<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="36dp"
    android:background="@drawable/node_tree_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <org.autojs.autojs.ui.widget.LevelBeamView
        android:id="@+id/dataItemLevelBeam"
        android:layout_width="wrap_content"
        android:layout_height="30dp"/>

    <ImageView
        android:id="@+id/dataItemArrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/ic_chevron_right"
        android:tint="#5C6370"/>

    <TextView
        android:id="@+id/dataItemLevelIndex"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="#5C6370"
        android:textSize="8sp"
        tools:text="2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dataItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="monospace"
            android:textColor="#F1F3FC"
            android:textSize="11sp"
            tools:text="TextView"/>

        <TextView
            android:id="@+id/dataItemInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#A8ABB3"
            android:textSize="8sp"
            tools:text="id/login_container · &quot;欢迎回来&quot;" />
    </LinearLayout>

    <TextView
        android:id="@+id/dataItemBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="2dp"
        android:background="@drawable/node_tree_badge_bg"
        android:fontFamily="monospace"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:text="已展开"
        android:textColor="#FF04110C"
        android:textSize="7sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>