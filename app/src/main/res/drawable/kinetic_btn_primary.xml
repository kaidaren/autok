<?xml version="1.0" encoding="utf-8"?>
<!-- Kinetic Button - Gradient Primary CTA -->
<!-- Linear gradient from primary to primary_container at 135 degrees -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/kinetic_primary"
        android:endColor="@color/kinetic_primary_container"
        android:type="linear" />
    <corners android:radius="@dimen/kinetic_radius_xl" />
</shape>
